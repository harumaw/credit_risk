// MVP скоринга МСП — схема PostgreSQL
// Вставьте файл на https://dbdiagram.io для интерактивной диаграммы

Project sme_scoring_mvp {
  database_type: 'PostgreSQL'
  Note: 'Личный кабинет МСП, заявки, антифрод, скоринговая карта, мониторинг моделей'
}

Enum user_status {
  pending_verification
  active
  blocked
}

Enum auth_provider {
  esia
  partner_bank
  ukep
  phone_otp
}

Enum staff_role {
  underwriter
  risk_analyst
  fraud_analyst
  assessor
  admin
}

Enum company_role {
  director
  founder
  accountant
  employee_poa
}

Enum link_status {
  pending
  confirmed
  revoked
}

Enum company_status {
  active
  reorganizing
  liquidating
  liquidated
  bankrupt
}

Enum msp_category {
  micro
  small
  medium
  not_msp
}

Enum tax_regime {
  osno
  usn_income
  usn_income_expense
  eshn
  psn
  ausn
}

Enum zsk_zone {
  green
  yellow
  red
}

Enum data_source {
  fns_egrul
  fns_tax
  gir_bo
  fssp
  efrsb
  kad_arbitr
  cbr_zsk
  bki
  rmsp
  partner_bank
  bank_internal
  manual
}

Enum fetch_status {
  pending
  success
  not_found
  error
}

Enum product_type {
  term_loan
  credit_line
  overdraft
  bank_guarantee
}

Enum application_status {
  draft
  submitted
  data_collection
  scoring
  manual_review
  approved
  offer_accepted
  contract_signed
  issued
  declined
  cancelled
}

Enum channel_type {
  paid
  organic
  partner
  referral
  direct
  offline
}

Enum event_platform {
  web
  ios
  android
  backend
}

Enum loan_txn_type {
  disbursement
  principal_repayment
  interest_payment
  fee
  penalty
  recovery
  write_off
}

Enum provision_stage {
  stage_1
  stage_2
  stage_3
}

Enum consent_type {
  personal_data
  bki_request
  tax_secret
  esia_data
  marketing
}

Enum decision_type {
  approve
  decline
  manual_review
  counter_offer
}

Enum loan_status {
  active
  closed
  defaulted
  written_off
}

Enum default_trigger {
  dpd_90
  bankruptcy
  distressed_restructuring
  write_off
  unlikely_to_pay
}

Enum check_result {
  pass
  flag
  fail
}

Enum fraud_label {
  fraud
  not_fraud
  suspicious
}

Enum model_status {
  development
  validation
  champion
  challenger
  retired
}

Enum stop_severity {
  hard
  soft
}

Table users [headercolor: #4F46E5] {
  id uuid [pk, default: `gen_random_uuid()`]
  esia_oid varchar(64) [unique, note: 'ID пользователя в ЕСИА']
  inn_fl varchar(12)
  last_name varchar(100) [not null]
  first_name varchar(100) [not null]
  middle_name varchar(100)
  phone varchar(20) [unique]
  email varchar(255)
  status user_status [not null, default: 'pending_verification']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Физлица — представители бизнеса (директор, бухгалтер)'
}

Table auth_identities [headercolor: #4F46E5] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  provider auth_provider [not null]
  external_subject varchar(255) [not null, note: 'oid ЕСИА / id в банке-партнёре / thumbprint']
  trust_level smallint [note: 'уровень учётки ЕСИА (подтверждённая и т.п.)']
  raw_claims jsonb
  verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, external_subject) [unique]
  }
}

Table ukep_certificates [headercolor: #4F46E5] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  thumbprint varchar(64) [not null, unique]
  serial_number varchar(64) [not null]
  issuer_cn varchar(255) [not null]
  owner_inn_fl varchar(12)
  owner_inn_ul varchar(10)
  owner_ogrn varchar(15)
  valid_from timestamptz [not null]
  valid_to timestamptz [not null]
  is_revoked boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Квалифицированные сертификаты (УКЭП) руководителей'
}

Table signatures [headercolor: #4F46E5] {
  id uuid [pk, default: `gen_random_uuid()`]
  certificate_id uuid [not null, ref: > ukep_certificates.id]
  object_type varchar(50) [not null, note: 'consent / application / company_link / document']
  object_id uuid [not null]
  payload_sha256 char(64) [not null]
  signature_cms bytea [not null, note: 'откреплённая подпись CAdES']
  is_valid boolean [not null]
  signed_at timestamptz [not null]

  indexes {
    (object_type, object_id)
  }
}

Table user_sessions [headercolor: #4F46E5] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  auth_identity_id uuid [ref: > auth_identities.id]
  ip inet
  user_agent text
  device_fingerprint varchar(128)
  geo jsonb
  session_risk_score "numeric(5,4)"
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  Note: 'Сырьё для антифрода: устройство, IP, гео'
}

Table staff_users [headercolor: #4F46E5] {
  id uuid [pk, default: `gen_random_uuid()`]
  full_name varchar(255) [not null]
  email varchar(255) [not null, unique]
  role staff_role [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Сотрудники банка: андеррайтеры, риск-аналитики, асессоры'
}

Table companies [headercolor: #0891B2] {
  id uuid [pk, default: `gen_random_uuid()`]
  inn varchar(12) [not null, unique]
  ogrn varchar(15) [unique]
  kpp varchar(9)
  full_name text [not null]
  short_name varchar(500)
  legal_form varchar(100) [note: 'ООО, АО, ИП ...']
  registration_date date
  status company_status [not null, default: 'active']
  region_code char(2)
  legal_address text
  msp_category msp_category
  headcount integer [note: 'среднесписочная численность']
  tax_regime tax_regime
  registry_synced_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Карточка юрлица/ИП (текущий срез из ЕГРЮЛ, РМСП)'
}

Table user_company_links [headercolor: #0891B2] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  company_id uuid [not null, ref: > companies.id]
  role company_role [not null]
  status link_status [not null, default: 'pending']
  confirmed_signature_id uuid [ref: > signatures.id, note: 'подтверждение УКЭП компании']
  poa_number varchar(100) [note: '№ машиночитаемой доверенности (МЧД)']
  valid_from date
  valid_to date
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, company_id, role) [unique]
  }
  Note: 'M:N директор ↔ компания'
}

Table okved_codes [headercolor: #0891B2] {
  code varchar(8) [pk]
  name text [not null]
  section char(1) [not null]
  parent_code varchar(8) [ref: > okved_codes.code]
  Note: 'Справочник ОКВЭД-2'
}

Table company_okved [headercolor: #0891B2] {
  company_id uuid [not null, ref: > companies.id]
  okved_code varchar(8) [not null, ref: > okved_codes.code]
  is_main boolean [not null, default: false]

  indexes {
    (company_id, okved_code) [pk]
  }
  Note: 'Массив ОКВЭД в нормализованном виде'
}

Table company_persons [headercolor: #0891B2] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  person_inn varchar(12)
  full_name varchar(300) [not null]
  role varchar(30) [not null, note: 'director / founder / beneficiary']
  share_pct "numeric(7,4)"
  date_from date
  date_to date
  is_mass_flag boolean [note: 'массовый директор/учредитель']
  Note: 'Связанные лица из ЕГРЮЛ — для графовых признаков'
}

Table data_fetches [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  source data_source [not null]
  status fetch_status [not null]
  requested_at timestamptz [not null, default: `now()`]
  received_at timestamptz
  raw_payload jsonb
  payload_sha256 char(64)
  cost_rub "numeric(12,2)" [note: 'стоимость запроса к источнику']
  error text

  indexes {
    (company_id, source, requested_at)
  }
  Note: 'Сырой слой: каждый ответ внешнего API хранится для воспроизводимости скоринга'
}

Table tax_debts [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  as_of_date date [not null]
  tax_debt "numeric(18,2)" [not null, default: 0]
  penalties "numeric(18,2)" [not null, default: 0]
  fines "numeric(18,2)" [not null, default: 0]
  fetch_id uuid [ref: > data_fetches.id]

  indexes {
    (company_id, as_of_date) [unique]
  }
  Note: 'Временной ряд налоговых долгов (для графика)'
}

Table risk_indices [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  provider varchar(50) [not null, note: 'внутренний / внешний агрегатор']
  index_code varchar(50) [not null]
  value "numeric(10,4)" [not null]
  as_of_date date [not null]
  fetch_id uuid [ref: > data_fetches.id]

  indexes {
    (company_id, provider, index_code, as_of_date) [unique]
  }
}

Table zsk_statuses [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  zone zsk_zone [not null]
  assigned_at date
  as_of_date date [not null]
  fetch_id uuid [ref: > data_fetches.id]

  indexes {
    (company_id, as_of_date) [unique]
  }
  Note: 'Платформа ЦБ «Знай своего клиента»'
}

Table enforcement_proceedings [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  ip_number varchar(50) [not null, unique, note: '№ исполнительного производства']
  opened_at date [not null]
  closed_at date
  close_reason varchar(100)
  subject text
  amount "numeric(18,2)"
  remaining_amount "numeric(18,2)"
  fetch_id uuid [ref: > data_fetches.id]
  Note: 'ФССП: флаг да/нет = EXISTS активных'
}

Table bankruptcy_events [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  case_number varchar(50)
  event_type varchar(80) [not null, note: 'намерение / наблюдение / конкурсное ...']
  event_date date [not null]
  is_self_initiated boolean
  fetch_id uuid [ref: > data_fetches.id]
  Note: 'ЕФРСБ / Федресурс'
}

Table arbitration_cases [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  case_number varchar(50) [not null]
  party_role varchar(20) [not null, note: 'plaintiff / defendant / third_party']
  category varchar(100)
  claim_amount "numeric(18,2)"
  filed_at date
  status varchar(50)
  fetch_id uuid [ref: > data_fetches.id]

  indexes {
    (company_id, case_number, party_role) [unique]
  }
}

Table fin_line_dictionary [headercolor: #65A30D] {
  line_code varchar(4) [pk, note: '1600, 2110, 2400 ...']
  name text [not null]
  form varchar(20) [not null, note: 'balance / pnl / cashflow']
  parent_code varchar(4) [ref: > fin_line_dictionary.line_code]
}

Table financial_statements [headercolor: #65A30D] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  fiscal_year smallint [not null]
  is_simplified boolean [not null, default: false]
  revision smallint [not null, default: 0, note: 'номер корректировки']
  published_at date
  fetch_id uuid [ref: > data_fetches.id]

  indexes {
    (company_id, fiscal_year, revision) [unique]
  }
  Note: 'ГИР БО (годовая БФО)'
}

Table financial_statement_lines [headercolor: #65A30D] {
  statement_id uuid [not null, ref: > financial_statements.id]
  line_code varchar(4) [not null, ref: > fin_line_dictionary.line_code]
  value_current "numeric(20,2)"
  value_previous "numeric(20,2)"

  indexes {
    (statement_id, line_code) [pk]
  }
  Note: 'Строки отчётности (long-формат)'
}

Table bank_accounts [headercolor: #65A30D] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  bank_bik varchar(9) [not null]
  account_masked varchar(30) [not null]
  currency char(3) [not null, default: 'RUB']
  is_own_bank boolean [not null, default: false]
  opened_at date
  closed_at date
}

Table monthly_turnovers [headercolor: #65A30D] {
  account_id uuid [not null, ref: > bank_accounts.id]
  month date [not null, note: '1-е число месяца']
  inflow "numeric(20,2)" [not null]
  outflow "numeric(20,2)" [not null]
  closing_balance "numeric(20,2)" [not null]
  tx_count integer
  counterparties_cnt integer
  source data_source [not null]

  indexes {
    (account_id, month) [pk]
  }
  Note: 'Обороты и остатки по месяцам'
}

Table turnover_forecasts [headercolor: #65A30D] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  model_version_id uuid [not null, ref: > model_versions.id]
  month date [not null]
  inflow_pred "numeric(20,2)"
  balance_pred "numeric(20,2)"
  lower_bound "numeric(20,2)"
  upper_bound "numeric(20,2)"
  created_at timestamptz [not null, default: `now()`]
}

Table credit_obligations [headercolor: #65A30D] {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, ref: > companies.id]
  source data_source [not null, note: 'bki / bank_internal']
  deal_uid varchar(40) [note: 'УИд сделки из КИ']
  lender_name varchar(300)
  product_type product_type
  limit_amount "numeric(20,2)"
  currency char(3) [default: 'RUB']
  opened_at date
  maturity_date date
  closed_at date
  outstanding "numeric(20,2)"
  overdue_amount "numeric(20,2)"
  max_dpd integer
  payment_string varchar(48) [note: 'статусы платежей по месяцам, 0 — последний: 0 / 1 (<30 дн.) / 2 (30+) / - нет данных']
  report_date date [not null]
  fetch_id uuid [ref: > data_fetches.id]
  Note: 'Кредиты, задолженность (КИ + внутренние)'
}

Table obligation_payments [headercolor: #65A30D] {
  id bigserial [pk]
  obligation_id uuid [not null, ref: > credit_obligations.id]
  due_date date [not null]
  paid_date date
  amount_due "numeric(20,2)" [not null]
  amount_paid "numeric(20,2)"
  dpd integer [not null, default: 0]
}

Table credit_products [headercolor: #D97706] {
  id serial [pk]
  code varchar(30) [not null, unique]
  name varchar(200) [not null]
  product_type product_type [not null]
  min_amount "numeric(18,2)"
  max_amount "numeric(18,2)"
  min_term_months smallint
  max_term_months smallint
  base_rate "numeric(6,3)"
  is_active boolean [not null, default: true]
}

Table loan_applications [headercolor: #D97706] {
  id uuid [pk, default: `gen_random_uuid()`]
  number varchar(20) [not null, unique, note: 'nextval(loan_application_number_seq), с 1001']
  company_id uuid [not null, ref: > companies.id]
  applicant_user_id uuid [not null, ref: > users.id]
  product_id integer [not null, ref: > credit_products.id]
  requested_amount "numeric(18,2)"
  requested_term_months smallint
  purpose text
  form_step smallint [not null, default: 1, note: 'шаг progress-bar']
  form_data jsonb [note: 'черновик формы']
  status application_status [not null, default: 'draft']
  acquisition_channel_code varchar(50) [ref: > marketing_channels.code, note: 'last non-direct touch перед созданием заявки']
  campaign_id uuid [ref: > marketing_campaigns.id]
  utm jsonb
  assigned_staff_id uuid [ref: > staff_users.id]
  submitted_at timestamptz
  decided_at timestamptz
  idempotency_key varchar(64) [note: 'заголовок Idempotency-Key: повтор отправки отдаёт ту же заявку']
  sign_code_hash char(64) [note: 'имитация подписания: sha256 кода из «SMS»']
  sign_code_expires_at timestamptz
  sign_code_attempts smallint [not null, default: 0, note: 'неверные вводы кода; после 5 код сгорает']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, status)
    (applicant_user_id, idempotency_key) [unique]
  }
}

Table application_status_history [headercolor: #D97706] {
  id bigserial [pk]
  application_id uuid [not null, ref: > loan_applications.id]
  from_status application_status
  to_status application_status [not null]
  changed_by_user_id uuid [ref: > users.id]
  changed_by_staff_id uuid [ref: > staff_users.id]
  comment text
  changed_at timestamptz [not null, default: `now()`]
  Note: 'Таймлайн статусов в ЛК + SLA'
}

Table application_documents [headercolor: #D97706] {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null, ref: > loan_applications.id]
  doc_type varchar(50) [not null]
  file_key text [not null, note: 'ключ в S3-хранилище']
  sha256 char(64) [not null]
  uploaded_by uuid [ref: > users.id]
  signature_id uuid [ref: > signatures.id]
  uploaded_at timestamptz [not null, default: `now()`]
}

Table collaterals [headercolor: #D97706] {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null, ref: > loan_applications.id]
  collateral_type varchar(30) [not null, note: 'real_estate / vehicle / surety / guarantee']
  description text
  market_value "numeric(18,2)"
  guarantor_inn varchar(12)
}

Table consents [headercolor: #D97706] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  company_id uuid [ref: > companies.id]
  application_id uuid [ref: > loan_applications.id]
  consent_type consent_type [not null]
  text_version varchar(20) [not null]
  signature_id uuid [ref: > signatures.id]
  signed_at timestamptz [not null]
  valid_until timestamptz
  revoked_at timestamptz
  Note: 'Согласия: ПДн (152-ФЗ), запрос в БКИ (218-ФЗ), налоговая тайна'
}

Table credit_decisions [headercolor: #D97706] {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null, ref: > loan_applications.id]
  score_result_id uuid [ref: > score_results.id]
  decision decision_type [not null]
  approved_amount "numeric(18,2)"
  approved_term_months smallint
  rate "numeric(6,3)"
  reason_codes "text[]"
  offer_expires_at timestamptz
  offer_accepted_at timestamptz
  decided_by_staff_id uuid [ref: > staff_users.id, note: 'NULL = автоматическое']
  comment text
  details jsonb [note: 'входы (доход, платежи, DSCR, стоп-факторы), модель, альтернативы, подсказки']
  decided_at timestamptz [not null, default: `now()`]
}

Table tasks [headercolor: #D97706] {
  id bigserial [pk]
  kind varchar(30) [not null, note: 'process_application']
  application_id uuid [ref: > loan_applications.id]
  payload jsonb
  status varchar(10) [not null, default: 'queued', note: 'queued / running / done / failed']
  attempts smallint [not null, default: 0]
  run_after timestamptz [not null, default: `now()`]
  locked_at timestamptz
  last_error text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, run_after)
  }
  Note: 'Очередь конвейера: воркер берёт задачу FOR UPDATE SKIP LOCKED'
}

Table staff_work_log [headercolor: #D97706] {
  id uuid [pk, default: `gen_random_uuid()`]
  staff_id uuid [not null, ref: > staff_users.id]
  application_id uuid [ref: > loan_applications.id]
  assessor_task_id uuid [ref: > assessor_tasks.id]
  activity varchar(30) [not null, note: 'review / doc_check / call / fraud_review']
  started_at timestamptz [not null]
  ended_at timestamptz
  duration_sec integer [note: 'фактическое рабочее время, без ожидания']

  indexes {
    (staff_id, started_at)
  }
  Note: 'Трудоёмкость → себестоимость обработки заявки'
}

Table fraud_checks [headercolor: #DC2626] {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [ref: > loan_applications.id]
  session_id uuid [ref: > user_sessions.id]
  check_code varchar(50) [not null, note: 'device_reuse / mass_director / partner_bank_blacklist ...']
  result check_result [not null]
  score "numeric(6,4)"
  details jsonb
  checked_at timestamptz [not null, default: `now()`]
}

Table assessor_tasks [headercolor: #DC2626] {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null, ref: > loan_applications.id]
  assigned_staff_id uuid [ref: > staff_users.id]
  priority smallint [not null, default: 3]
  sampling_reason varchar(30) [note: 'flagged / random_sample / disputed']
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
}

Table fraud_labels [headercolor: #DC2626] {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null, ref: > assessor_tasks.id]
  label fraud_label [not null]
  fraud_type varchar(50) [note: 'nominee / identity_theft / shell ...']
  comment text
  labeled_by uuid [not null, ref: > staff_users.id]
  labeled_at timestamptz [not null, default: `now()`]
  Note: 'Асессорская разметка → таргет антифрод-модели'
}

Table feature_definitions [headercolor: #7C3AED] {
  code varchar(80) [pk]
  name varchar(255) [not null]
  description text
  data_type varchar(20) [not null, note: 'numeric / categorical / boolean']
  source data_source [not null]
  sql_or_formula text [note: 'как считается']
  is_active boolean [not null, default: true]
  Note: 'Feature store: каталог признаков'
}

Table model_versions [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  model_name varchar(100) [not null]
  version varchar(20) [not null]
  model_type varchar(30) [not null, note: 'scorecard / logreg / gbm / forecast']
  segment_code varchar(30) [ref: > scoring_segments.code, note: 'к какому сегменту применяется; champion сегмента — рабочая модель']
  status model_status [not null, default: 'development']
  target_definition text [not null, note: 'напр. 90+ dpd за 12 мес.']
  train_from date
  train_to date
  oot_from date
  oot_to date
  gini_train "numeric(5,4)"
  gini_oot "numeric(5,4)"
  ks_oot "numeric(5,4)"
  cutoff_score "numeric(10,2)"
  artifact_uri text
  params jsonb [note: 'шкала (pdo, base_score, odds), калибровка PD: a + b·score']
  approved_by uuid [ref: > staff_users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (model_name, version) [unique]
  }
}

Table scoring_segments [headercolor: #7C3AED] {
  code varchar(30) [pk]
  name varchar(200) [not null]
  description text
  priority smallint [not null, note: 'меньше — проверяется раньше; первый подошедший активный сегмент']
  conditions jsonb [not null, note: '{"all"|"any": [{"feature", "op", "value"}]}; {} — подходит всем']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Когда какую модель применять'
}

Table ml_dataset_samples [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  dataset_code varchar(40) [not null, note: 'synthetic_v1 ...']
  company_id uuid [not null, ref: > companies.id]
  source_ref bigint [note: 'id заявки в исходнике']
  as_of_date date [not null]
  segment_code varchar(30) [ref: > scoring_segments.code]
  sample varchar(10) [not null, note: 'train / valid / oot / excluded']
  target smallint
  features jsonb [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (dataset_code, company_id) [unique]
  }
  Note: 'Выборка для обучения и валидации: признаки на дату заявки + таргет'
}

Table model_features [headercolor: #7C3AED] {
  model_version_id uuid [not null, ref: > model_versions.id]
  feature_code varchar(80) [not null, ref: > feature_definitions.code]
  coefficient "numeric(12,6)"
  information_value "numeric(8,5)"

  indexes {
    (model_version_id, feature_code) [pk]
  }
}

Table scorecard_bins [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  model_version_id uuid [not null, ref: > model_versions.id]
  feature_code varchar(80) [not null, ref: > feature_definitions.code]
  bin_order smallint [not null]
  lower_bound numeric
  upper_bound numeric
  categories "text[]"
  is_missing_bin boolean [not null, default: false]
  woe "numeric(10,6)" [not null]
  points "numeric(8,2)" [not null]
  event_rate "numeric(6,5)"
  population_share "numeric(6,5)"

  indexes {
    (model_version_id, feature_code, bin_order) [unique]
  }
  Note: 'Бины карты: WoE и баллы'
}

Table rating_scale [headercolor: #7C3AED] {
  id serial [pk]
  model_version_id uuid [not null, ref: > model_versions.id]
  grade varchar(5) [not null]
  score_from "numeric(10,2)" [not null]
  score_to "numeric(10,2)" [not null]
  pd_calibrated "numeric(7,6)" [not null]

  indexes {
    (model_version_id, grade) [unique]
  }
  Note: 'Мастер-шкала: балл → грейд → PD'
}

Table stop_factors [headercolor: #7C3AED] {
  code varchar(50) [pk]
  name varchar(255) [not null]
  severity stop_severity [not null]
  rule_expression text [not null]
  is_active boolean [not null, default: true]
  Note: 'ZSK_RED, BANKRUPTCY_PROC, FSSP_OVER_X, AGE_LT_6M ...'
}

Table score_results [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [ref: > loan_applications.id]
  company_id uuid [not null, ref: > companies.id]
  model_version_id uuid [not null, ref: > model_versions.id]
  as_of_date date [not null, note: 'дата среза данных']
  total_score "numeric(10,2)"
  pd "numeric(7,6)"
  grade varchar(5)
  has_hard_stop boolean [not null, default: false]
  input_sha256 char(64) [note: 'хэш входа для воспроизводимости']
  latency_ms integer
  calculated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, calculated_at)
  }
}

Table score_feature_values [headercolor: #7C3AED] {
  score_result_id uuid [not null, ref: > score_results.id]
  feature_code varchar(80) [not null, ref: > feature_definitions.code]
  value_num numeric
  value_text text
  bin_id uuid [ref: > scorecard_bins.id]
  points "numeric(8,2)"

  indexes {
    (score_result_id, feature_code) [pk]
  }
  Note: 'Объяснимость: вклад каждого признака'
}

Table stop_factor_results [headercolor: #7C3AED] {
  score_result_id uuid [not null, ref: > score_results.id]
  stop_factor_code varchar(50) [not null, ref: > stop_factors.code]
  triggered boolean [not null]
  details jsonb

  indexes {
    (score_result_id, stop_factor_code) [pk]
  }
}

Table model_monitoring [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  model_version_id uuid [not null, ref: > model_versions.id]
  period_month date [not null]
  population_cnt integer [not null]
  approval_rate "numeric(5,4)"
  psi "numeric(8,5)"
  gini "numeric(5,4)"
  default_rate_obs "numeric(7,6)"
  pd_avg_pred "numeric(7,6)"
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (model_version_id, period_month) [unique]
  }
}

Table risk_parameters [headercolor: #7C3AED] {
  id serial [pk]
  param_code varchar(30) [not null, note: 'LGD / CCF']
  segment_code varchar(30) [not null, default: 'all']
  product_type product_type
  value "numeric(7,6)" [not null]
  valid_from date [not null]
  valid_to date
  comment text

  indexes {
    (param_code, segment_code, product_type, valid_from) [unique]
  }
  Note: 'LGD/CCF для ожидаемых потерь EL = PD × LGD × EAD'
}

Table loans [headercolor: #DB2777] {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null, unique, ref: > loan_applications.id]
  company_id uuid [not null, ref: > companies.id]
  contract_number varchar(50) [not null, unique]
  amount "numeric(18,2)" [not null]
  rate "numeric(6,3)" [not null]
  term_months smallint [not null]
  issued_at date [not null]
  maturity_date date [not null]
  status loan_status [not null, default: 'active']
  Note: 'Выданные кредиты (для сбора таргета)'
}

Table loan_monthly_performance [headercolor: #DB2777] {
  loan_id uuid [not null, ref: > loans.id]
  report_month date [not null]
  mob smallint [not null, note: 'month on book — для винтажей/когорт']
  outstanding "numeric(18,2)" [not null]
  dpd integer [not null, default: 0]
  dpd_bucket varchar(8) [not null, note: '0 / 1-30 / 31-60 / 61-90 / 90+']
  is_restructured boolean [not null, default: false]

  indexes {
    (loan_id, report_month) [pk]
  }
  Note: 'Помесячный срез → матрицы переходов (roll-rate)'
}

Table default_events [headercolor: #DB2777] {
  id uuid [pk, default: `gen_random_uuid()`]
  loan_id uuid [ref: > loans.id]
  company_id uuid [not null, ref: > companies.id]
  trigger default_trigger [not null]
  default_date date [not null]
  cured_at date
  Note: 'Единое определение дефолта (таргет)'
}

Table audit_log [headercolor: #475569] {
  id bigserial [pk]
  actor_type varchar(10) [not null, note: 'user / staff / system']
  actor_id uuid
  action varchar(50) [not null]
  entity_type varchar(50) [not null]
  entity_id uuid
  diff jsonb
  ip inet
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id)
  }
  Note: 'Append-only журнал действий'
}

Table marketing_channels [headercolor: #2563EB] {
  code varchar(50) [pk, note: 'yandex_direct / seo / partner_bank_x / referral']
  name varchar(200) [not null]
  channel_type channel_type [not null]
  is_active boolean [not null, default: true]
  Note: 'Справочник каналов привлечения'
}

Table marketing_campaigns [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`]
  channel_code varchar(50) [not null, ref: > marketing_channels.code]
  utm_campaign varchar(200) [not null]
  name varchar(300)
  started_at date
  ended_at date

  indexes {
    (channel_code, utm_campaign) [unique]
  }
}

Table marketing_spend [headercolor: #2563EB] {
  campaign_id uuid [not null, ref: > marketing_campaigns.id]
  spend_date date [not null]
  amount "numeric(14,2)" [not null]
  impressions bigint
  clicks bigint

  indexes {
    (campaign_id, spend_date) [pk]
  }
  Note: 'Расходы по дням → CAC / CPA'
}

Table partners [headercolor: #2563EB] {
  code varchar(50) [pk]
  name varchar(300) [not null]
  partner_type varchar(30) [not null, note: 'bank / marketplace / agent']
  commission_model text
  is_active boolean [not null, default: true]
}

Table partner_referrals [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`]
  partner_code varchar(50) [not null, ref: > partners.code]
  company_id uuid [ref: > companies.id]
  application_id uuid [ref: > loan_applications.id]
  external_ref varchar(100)
  referred_at timestamptz [not null]
  commission_amount "numeric(14,2)"
  commission_paid_at date
}

Table analytics_events [headercolor: #2563EB] {
  event_id uuid [not null, default: `gen_random_uuid()`]
  event_ts timestamptz [not null, note: 'время на клиенте']
  received_at timestamptz [not null, default: `now()`]
  event_name varchar(80) [not null, note: 'application_start, form_step_completed ...']
  anonymous_id varchar(64) [note: 'cookie / device id']
  user_id uuid [ref: > users.id]
  company_id uuid [ref: > companies.id]
  application_id uuid [ref: > loan_applications.id]
  session_id uuid [ref: > user_sessions.id]
  platform event_platform [not null]
  app_version varchar(20)
  page text
  referrer text
  utm_source varchar(200)
  utm_medium varchar(200)
  utm_campaign varchar(200)
  utm_content varchar(200)
  utm_term varchar(200)
  properties jsonb [note: 'шаг формы, блок дашборда, поле автозаполнения ...']

  indexes {
    (event_id, event_ts) [pk]
    (event_name, event_ts)
    (anonymous_id)
    (company_id, event_ts)
  }
  Note: 'Сырые продуктовые события; в SQL — партиционирование по месяцам'
}

Table identity_links [headercolor: #2563EB] {
  anonymous_id varchar(64) [not null]
  user_id uuid [not null, ref: > users.id]
  first_seen_at timestamptz [not null]
  linked_at timestamptz [not null, default: `now()`]

  indexes {
    (anonymous_id, user_id) [pk]
  }
  Note: 'Склейка anonymous_id → user_id при входе через ЕСИА'
}

Table company_attribution [headercolor: #2563EB] {
  company_id uuid [pk, ref: > companies.id]
  first_touch_channel_code varchar(50) [ref: > marketing_channels.code]
  first_touch_campaign_id uuid [ref: > marketing_campaigns.id]
  first_touch_at timestamptz
  first_user_id uuid [ref: > users.id]
  attributed_at timestamptz [not null, default: `now()`]
  Note: 'First-touch канал компании (по самому раннему касанию любого её пользователя)'
}

Table loan_schedule [headercolor: #CA8A04] {
  loan_id uuid [not null, ref: > loans.id]
  installment_no smallint [not null]
  due_date date [not null]
  principal_due "numeric(18,2)" [not null]
  interest_due "numeric(18,2)" [not null]

  indexes {
    (loan_id, installment_no) [pk]
  }
  Note: 'График платежей → точный FPD и DPD'
}

Table loan_transactions [headercolor: #CA8A04] {
  id bigserial [pk]
  loan_id uuid [not null, ref: > loans.id]
  txn_type loan_txn_type [not null]
  txn_date date [not null]
  amount "numeric(18,2)" [not null]
  installment_no smallint
  external_ref varchar(100) [note: 'id проводки в АБС']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (loan_id, txn_date)
  }
  Note: 'Фактические денежные потоки по кредиту'
}

Table funding_rates [headercolor: #CA8A04] {
  id serial [pk]
  term_months_from smallint [not null]
  term_months_to smallint [not null]
  rate "numeric(6,3)" [not null, note: '% годовых, трансфертная ставка (FTP)']
  valid_from date [not null]
  valid_to date

  indexes {
    (term_months_from, term_months_to, valid_from) [unique]
  }
}

Table loan_provisions [headercolor: #CA8A04] {
  loan_id uuid [not null, ref: > loans.id]
  report_month date [not null]
  stage provision_stage [not null]
  provision_rate "numeric(7,6)" [not null]
  provision_amount "numeric(18,2)" [not null]

  indexes {
    (loan_id, report_month) [pk]
  }
  Note: 'Резервы на конец месяца → cost of risk'
}

Table plan_targets [headercolor: #CA8A04] {
  id serial [pk]
  metric_code varchar(80) [not null, note: 'issued_amount / approval_rate / cac ...']
  period_month date [not null]
  segment varchar(50) [not null, default: 'all']
  target_value "numeric(20,4)" [not null]

  indexes {
    (metric_code, period_month, segment) [unique]
  }
  Note: 'План для плиток «план/факт»'
}

TableGroup identity [color: #4F46E5] {
  Note: '1. Идентификация и доступ'
  users
  auth_identities
  ukep_certificates
  signatures
  user_sessions
  staff_users
}

TableGroup company [color: #0891B2] {
  Note: '2. Компании и связи'
  companies
  user_company_links
  okved_codes
  company_okved
  company_persons
}

TableGroup external [color: #059669] {
  Note: '3. Внешние данные (point-in-time)'
  data_fetches
  tax_debts
  risk_indices
  zsk_statuses
  enforcement_proceedings
  bankruptcy_events
  arbitration_cases
}

TableGroup finance [color: #65A30D] {
  Note: '4. Финансы, обороты, кредиты'
  fin_line_dictionary
  financial_statements
  financial_statement_lines
  bank_accounts
  monthly_turnovers
  turnover_forecasts
  credit_obligations
  obligation_payments
}

TableGroup apps [color: #D97706] {
  Note: '5. Заявки (CRM)'
  credit_products
  loan_applications
  application_status_history
  application_documents
  collaterals
  consents
  credit_decisions
  tasks
  staff_work_log
}

TableGroup fraud [color: #DC2626] {
  Note: '6. Антифрод и разметка'
  fraud_checks
  assessor_tasks
  fraud_labels
}

TableGroup scoring [color: #7C3AED] {
  Note: '7. Скоринг и модели'
  feature_definitions
  scoring_segments
  model_versions
  model_features
  scorecard_bins
  rating_scale
  stop_factors
  score_results
  score_feature_values
  stop_factor_results
  model_monitoring
  ml_dataset_samples
  risk_parameters
}

TableGroup portfolio [color: #DB2777] {
  Note: '8. Портфель и дефолты'
  loans
  loan_monthly_performance
  default_events
}

TableGroup audit [color: #475569] {
  Note: '9. Аудит'
  audit_log
}

TableGroup analytics [color: #2563EB] {
  Note: '10. Продуктовая аналитика и маркетинг'
  marketing_channels
  marketing_campaigns
  marketing_spend
  partners
  partner_referrals
  analytics_events
  identity_links
  company_attribution
}

TableGroup money [color: #CA8A04] {
  Note: '11. Деньги, резервы, план'
  loan_schedule
  loan_transactions
  funding_rates
  loan_provisions
  plan_targets
}
