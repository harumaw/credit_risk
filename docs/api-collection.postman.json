{
  "info": {
    "name": "Кредитный кабинет МСБ — API",
    "description": "Сквозной сценарий через API: регистрация, тестовая компания, заявка, контрпредложение, подпись кодом, выдача; отзыв заявки; кабинет администратора.\n\nЗапуск: `docker compose up`, затем Collection Runner по порядку. baseUrl — фронт (nginx проксирует API). Полное описание API — http://localhost:8000/docs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Клиент",
      "item": [
        {
          "name": "Регистрация",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Новый пользователь: email и ИНН физлица генерируются перед запросом. email, ИНН и телефон (необязательный) у пользователей не повторяются. Не больше 3 регистраций в минуту с одного адреса.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"last_name\": \"Тестов\",\n  \"first_name\": \"Пётр\",\n  \"middle_name\": \"Иванович\",\n  \"inn_fl\": \"{{innFl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Новый email и ИНН физлица на каждый прогон: оба должны быть уникальны",
                  "const d = [7, 7]; for (let i = 0; i < 8; i++) d.push(Math.floor(Math.random() * 10));",
                  "const check = (w) => d.reduce((s, x, i) => s + x * w[i], 0) % 11 % 10;",
                  "d.push(check([7, 2, 4, 10, 3, 5, 9, 4, 6, 8]));",
                  "d.push(check([3, 7, 2, 4, 10, 3, 5, 9, 4, 6, 8]));",
                  "pm.collectionVariables.set(\"innFl\", d.join(\"\"));",
                  "pm.collectionVariables.set(\"email\", `tester${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Токен сохраняется в переменную token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Профиль",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Компании",
      "item": [
        {
          "name": "Проверить ИНН",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies/lookup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "lookup"
              ]
            },
            "description": "Что найдено в реестре и можно ли добавить. 9900000024 — тестовая компания «контрпредложение», её может добавить любой пользователь.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inn\": \"{{companyInn}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Добавить компанию",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies"
              ]
            },
            "description": "Собирает данные из всех источников симулятора. Повторно та же компания — 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inn\": \"{{companyInn}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"companyId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Мои компании",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Заявка: контрпредложение → подпись → выдача",
      "item": [
        {
          "name": "Кредитные продукты",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Отправить заявку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications"
              ]
            },
            "description": "Повтор с тем же Idempotency-Key вернёт ту же заявку, вторую не создаст.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"productCode\": \"{{productCode}}\",\n  \"amount\": 5000000,\n  \"termMonths\": 12,\n  \"purpose\": \"Пополнение оборотных средств\",\n  \"consentPersonalData\": true,\n  \"consentBki\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ключ идемпотентности: повтор запроса с тем же ключом вернёт ту же заявку",
                  "if (!pm.collectionVariables.get(\"idempotencyKey\")) pm.collectionVariables.set(\"idempotencyKey\", crypto.randomUUID());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"applicationId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Заявка (ждём решение)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{applicationId}}"
              ]
            },
            "description": "Решение приходит через несколько секунд. Вручную — повторяйте запрос, пока status не станет counter_offer; в Collection Runner запрос повторяется сам."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Между повторами — пауза 2 с",
                  "if (Number(pm.collectionVariables.get(\"pollCount\") || 0) > 0) setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const app = pm.response.json();",
                  "const n = Number(pm.collectionVariables.get(\"pollCount\") || 0);",
                  "// В Collection Runner повторяем запрос, пока конвейер не вынес решение (до 30 раз)",
                  "if ([\"submitted\", \"checking\"].includes(app.status) && n < 30) {",
                  "  pm.collectionVariables.set(\"pollCount\", n + 1);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set(\"pollCount\", 0);",
                  "  pm.test(\"Есть решение: контрпредложение\", () => pm.expect(app.status).to.eql(\"counter_offer\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Принять второй вариант",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{applicationId}}",
                "accept"
              ]
            },
            "description": "offerIndex — номер варианта из decision.offers (с нуля).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerIndex\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Статус заявки signing\", () => pm.expect(pm.response.json().status).to.eql(\"signing\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить код подписи",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/sign-code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{applicationId}}",
                "sign-code"
              ]
            },
            "description": "Имитация SMS: код приходит в ответе."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"signCode\", pm.response.json().code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Подписать договор",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/sign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{applicationId}}",
                "sign"
              ]
            },
            "description": "Неверный код — 422; после 5 неверных вводов код сгорает, нужен новый.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{signCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Кредит выдан\", () => pm.expect(pm.response.json().status).to.eql(\"issued\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Отзыв заявки",
      "item": [
        {
          "name": "Отправить ещё заявку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{cancelKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"productCode\": \"{{productCode}}\",\n  \"amount\": 1000000,\n  \"termMonths\": 12,\n  \"purpose\": \"Закупка товара\",\n  \"consentPersonalData\": true,\n  \"consentBki\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"cancelKey\", crypto.randomUUID());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"cancelId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Отозвать заявку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{cancelId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{cancelId}}",
                "cancel"
              ]
            },
            "description": "Можно до выдачи. После выдачи — 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Заявка закрыта\", () => pm.expect(pm.response.json().status).to.eql(\"cancelled\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Администратор",
      "item": [
        {
          "name": "Вход сотрудника",
