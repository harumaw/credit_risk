POSTGRES_DSN=postgresql+asyncpg://app:secret@localhost:5432/app_db

# Внешние источники (по умолчанию — локальный симулятор: uvicorn simulator.main:app --port 8100)
EGRUL_URL=http://localhost:8100
FNS_URL=http://localhost:8100
RMSP_URL=http://localhost:8100
FSSP_URL=http://localhost:8100
EFRSB_URL=http://localhost:8100
ZSK_URL=http://localhost:8100
BKI_URL=http://localhost:8100
ABS_URL=http://localhost:8100
SOURCE_TIMEOUT_SECONDS=5
SOURCE_RETRIES=3
SOURCE_BACKOFF_SECONDS=0.5

# Предварительный лимит в кабинете
PRELIMINARY_RATE_PCT=24
PRELIMINARY_TERM_MONTHS=12

# Воркер конвейера (python -m app.worker) и SSE статусов заявки
WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=10
WORKER_STALE_SECONDS=300
WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat
EVENTS_POLL_SECONDS=1
EVENTS_MAX_SECONDS=600
# Кабинет администратора /adminuser
ADMIN_LOGIN=ovv
ADMIN_PASSWORD=1234567890@
